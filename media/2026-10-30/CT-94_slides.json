[{"kicker": "ふるさと納税", "main": "結局いくら\nまでOK？", "sec": 1.8}, {"kicker": "自己負担", "main": "2,000円", "accent": true, "sub": "で済むのは上限内だけ", "sec": 3.6}, {"kicker": "住民税の特例分の上限は", "main": "所得割の\n2割", "sub": "総務省の説明より", "sec": 3.6}, {"kicker": "上限を超えると", "main": "自己負担が\n増える", "sub": "2,000円では済まない", "sec": 3.4}, {"kicker": "例：3万円を寄附", "main": "控除の対象\n28,000円", "sub": "寄附額−2,000円", "sec": 3.4}, {"kicker": "住民税の基本分は", "main": "その10%", "sub": "寄附額−2,000円の10%\n残りは所得税と特例分", "sec": 3.6}, {"kicker": "確定申告するなら", "main": "翌年\n3月15日まで", "sub": "寄附した翌年に申告", "sec": 3.6}, {"kicker": "保存して見返してね", "main": "「チェック」\nとコメント", "sub": "年末調整の確認チェックリスト\nnoteで無料公開中", "sec": 4.0}]